# Timeblaster main daemon: alarm clock, hardware controller, television
# controller and companion-app server.
#
# It runs unprivileged. Privileged networking is delegated to
# timeblaster-wifi.service over a unix socket, so this process can neither
# reconfigure the network nor run an arbitrary command.

[Unit]
Description=Timeblaster alarm clock and controller
Documentation=file:/usr/share/doc/timeblaster/architecture.md
After=network.target sound.target time-sync.target
# ErsatzTV is deliberately only a "Wants": the alarm clock must start, and keep
# running, whether or not the television stack is healthy.
Wants=ersatztv.service timeblaster-wifi.service

[Service]
Type=simple
User=timeblaster
Group=timeblaster

# dialout: the Nano's USB serial port.
# audio:   the USB alarm speaker via ALSA.
# video, render: DRM/KMS access so mpv can drive HDMI with no desktop session.
SupplementaryGroups=dialout audio video render

ExecStart=/usr/local/bin/timeblasterd --config /etc/timeblaster/timeblaster.toml

# The alarm clock is the highest-priority function on this device, so it is
# always restarted, with a short delay and no start-limit burst that could leave
# it stopped after a bad night.
Restart=always
RestartSec=3
StartLimitIntervalSec=0

# SIGTERM unwinds gracefully: the speaker is silenced, the Nano is told the alarm
# ended, and the database is closed. 45 seconds is generous but bounded.
KillSignal=SIGTERM
TimeoutStopSec=45

# systemd creates and owns these, so the daemon never needs to mkdir as root.
RuntimeDirectory=timeblaster
RuntimeDirectoryMode=0750
StateDirectory=timeblaster
StateDirectoryMode=0750

# Logs go to stderr; journald captures them. Read them with:
#   journalctl -u timeblaster.service -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=timeblaster

# --- Hardening --------------------------------------------------------------
# The daemon needs the serial port, the sound card and the DRM device, and
# nothing else. Everything below is what remains after removing what it does not.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RemoveIPC=yes

ReadWritePaths=/var/lib/timeblaster /run/timeblaster
# Device access, allow-listed rather than inherited wholesale.
DeviceAllow=char-ttyACM rw
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-drm rw
DeviceAllow=char-alsa rw
DeviceAllow=/dev/dri/card0 rw
DeviceAllow=/dev/dri/card1 rw
DeviceAllow=/dev/dri/renderD128 rw

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# mpv and the alarm player are started by this service and must be able to run.
# CAP_NET_BIND_SERVICE lets web.listen_address use port 80 if configured; with
# the default of :8080 it is unused but harmless.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Leave headroom for ErsatzTV's FFmpeg work: the daemon itself is tiny.
MemoryMax=512M
# Firing an alarm on time matters more than anything else on the box, so give the
# daemon a small scheduling advantage over a busy transcode.
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=2

[Install]
WantedBy=multi-user.target
