# Timeblaster privileged network helper.
#
# This is the only Timeblaster component that runs as root. It exists so that the
# main daemon does not have to: it owns every nmcli invocation and serves the
# captive-portal page while Wi-Fi setup mode is active.
#
# It never raises an access point on its own. Setup mode has exactly one entry
# path — holding the Wi-Fi button for five seconds — and the main daemon asks for
# it over the socket below.

[Unit]
Description=Timeblaster network helper
# Belongs in [Unit]; systemd ignores it in [Service].
StartLimitIntervalSec=0
Documentation=file:/usr/share/doc/timeblaster/wifi-setup.md
After=NetworkManager.service
Requires=NetworkManager.service

[Service]
Type=simple
# Root for NetworkManager, for binding port 80 on the setup network, and for
# becoming the Connect user to toggle remote access. Root is the default for a
# system unit, and it has to stay implicit: writing User=root alongside a
# non-root Group= makes systemd take a uid-changing path that drops CAP_SETUID,
# and runuser then fails with "cannot set user id: Operation not permitted"
# while every capability still shows up in the bounding set. Group=timeblaster
# alone keeps the capability and still gives the socket the right owner.
#
# The timeblaster group is so that /run/timeblaster and the socket inside it are
# reachable by the unprivileged daemon. Without it the two units race to create
# the directory and whichever loses cannot use it.
Group=timeblaster
ExecStart=/usr/local/bin/timeblaster-wifi --config /etc/timeblaster/timeblaster.toml

Restart=always
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=60

# The socket lives here and is group-owned by timeblaster, mode 0660, so the main
# daemon can reach it and nothing else on the system can.
RuntimeDirectory=timeblaster
# 0770 with the shared group, so both this unit and the unprivileged daemon can
# write here regardless of which one creates the directory.
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=timeblaster-wifi

# --- Hardening --------------------------------------------------------------
# Root is required for NetworkManager, for binding port 80 on the setup network,
# and for becoming the Connect user to start and stop remote access. Everything
# not needed for that is removed.
NoNewPrivileges=yes
ProtectSystem=strict
# read-only rather than yes: Raspberry Pi Connect's units are user units, and
# reaching the user bus needs the account's home visible. With ProtectHome=yes
# `rpi-connect status` reports "not running" for a service that is running --
# a false negative that would have shipped a switch showing the wrong state.
# read-only is the smallest relaxation that works; tmpfs does not.
ProtectHome=read-only
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

# /run/user is the Connect user's bus directory, which systemctl --user needs
# to find their manager.
ReadWritePaths=/run/timeblaster /etc/NetworkManager /run/user
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

MemoryMax=128M

[Install]
WantedBy=multi-user.target
