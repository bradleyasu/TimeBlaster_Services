# Build output. Anchored: an unanchored bin/ also matched deploy/bin/, which
# silently kept timeblaster-etv-offline-image out of the repository. The deployed
# Pi only had it because it was copied over by hand, and the first install from a
# clean checkout failed on it.
/bin/
*.exe
/timeblasterd
/timeblaster-wifi
/tbctl

# Local development scratch: `make dev` creates this.
.dev/

# Test and coverage artefacts
coverage.out
coverage.html
*.test

# Python bytecode from the asset and splash scripts
__pycache__/
*.pyc

# Editor and OS noise
.DS_Store
*.swp
*~
.idea/
.vscode/

# Never commit a real database or a user's sound files.
*.db
*.db-wal
*.db-shm
deploy/sounds/
